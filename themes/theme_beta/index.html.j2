        <div class="case-grid">{% for b in section.bullets %}{% set parts = b.text.split(' :: ') %}<div class="case-card"><div class="case-card-label">{{ b.label }}</div>{% if parts|length >= 1 %}<p class="case-card-intro">{{ parts[0] }}</p>{% endif %}{% if parts|length >= 2 %}<p class="case-card-point">{{ parts[1] }}</p>{% endif %}{% if parts|length >= 3 %}<p class="case-card-outro">{{ parts[2] }}</p>{% endif %}</div>{% endfor %}</div>
