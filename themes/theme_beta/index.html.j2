      </div>
    </section>

    {% elif section.id == 'retention_timeline' %}
    <section class="section section--alt">
      <div class="page-wrap">
        <h2 class="section-heading">{{ section.heading }}</h2>
        {% if section.paragraphs %}<p class="section-intro">{{ section.paragraphs[0] }}</p>{% endif %}
        <div class="retention-list">{% for b in section.bullets %}<div class="retention-item"><div class="retention-dot"></div><div><div class="retention-label">{{ b.label }}</div><div class="retention-text">{{ b.text }}</div></div></div>{% endfor %}</div>
      </div>
