<!-- ═══ PDF Signing Flow Simulator ═══ -->
<section class="tool-section">
<div class="tool-wrap">
  <div class="tool-header">
    <span class="tool-lbl">Free Tool</span>
    <h2 class="tool-title">Online Document Signing Simulator</h2>
    <p class="tool-sub">Experience the signing flow — select a template, fill in your details, and sign. No account needed.</p>
  </div>

  <!-- Step 1: Template picker -->
  <div class="sim-step" id="step-1">
    <p class="sim-step-label">Step 1 — Choose a document template</p>
    <div class="tpl-grid">
      <button class="tpl-card" onclick="selectTemplate('NDA','Non-Disclosure Agreement','This Non-Disclosure Agreement is entered into between the parties listed below. Each party agrees to keep confidential all proprietary information shared during the course of their business relationship. This includes trade secrets, financial data, customer lists, and any other sensitive information. Breach of this agreement may result in legal action.')">
        <div class="tpl-icon">🔒</div>
        <div class="tpl-name">NDA</div>
        <div class="tpl-desc">Non-Disclosure Agreement</div>
      </button>
      <button class="tpl-card" onclick="selectTemplate('SERVICE','Service Agreement','This Service Agreement is made between the Client and the Service Provider. The Provider agrees to deliver the services described herein in a professional manner. Payment terms, deliverables, and timelines are outlined in Schedule A. Either party may terminate this agreement with 30 days written notice.')">
        <div class="tpl-icon">📋</div>
        <div class="tpl-name">Service</div>
        <div class="tpl-desc">Service Agreement</div>
      </button>
      <button class="tpl-card" onclick="selectTemplate('LEASE','Lease Agreement','This Lease Agreement is entered into between the Landlord and Tenant for the property described below. The lease term begins on the date signed and continues for the period specified. Tenant agrees to pay rent on the first of each month and maintain the property in good condition.')">
        <div class="tpl-icon">🏠</div>
        <div class="tpl-name">Lease</div>
        <div class="tpl-desc">Lease Agreement</div>
      </button>
    </div>
  </div>

  <!-- Step 2: Document preview + fields -->
  <div class="sim-step hidden" id="step-2">
    <p class="sim-step-label">Step 2 — Review and fill in your details</p>
    <div class="doc-preview">
      <div class="doc-header">
        <div class="doc-title-row">
          <span class="doc-badge" id="doc-badge">NDA</span>
          <span class="doc-title-text" id="doc-title-text">Non-Disclosure Agreement</span>
        </div>
        <div class="doc-meta">Document #<span id="doc-number"></span> · <span id="doc-date"></span></div>
      </div>
      <div class="doc-body" id="doc-body"></div>
      <div class="doc-fields">
        <div class="field-row">
          <label class="field-label">Full Name</label>
          <input class="field-input" id="f-name" type="text" placeholder="Enter your full name">
        </div>
        <div class="field-row">
          <label class="field-label">Email</label>
          <input class="field-input" id="f-email" type="email" placeholder="your@email.com">
        </div>
        <div class="field-row">
          <label class="field-label">Date</label>
          <input class="field-input" id="f-date" type="text" readonly>
        </div>
        <div class="field-row">
          <label class="field-label">Signature</label>
          <div class="sig-box" id="sig-box">
            <canvas id="sig-canvas" width="400" height="80"></canvas>
            <div class="sig-placeholder" id="sig-placeholder">Click to sign</div>
            <button class="sig-clear" id="sig-clear" onclick="clearSig()" style="display:none">Clear</button>
          </div>
        </div>
      </div>
      <button class="btn-sign" onclick="doSign()">Sign Document →</button>
    </div>
  </div>

  <!-- Step 3: Signed confirmation + audit trail -->
  <div class="sim-step hidden" id="step-3">
    <p class="sim-step-label">Step 3 — Document signed successfully</p>
    <div class="signed-card">
      <div class="signed-badge">✓ Signed</div>
      <div class="signed-title" id="signed-title"></div>
      <div class="audit-trail">
        <div class="audit-header">Audit Trail</div>
        <div class="audit-row"><span class="audit-key">Signer</span><span class="audit-val" id="a-name"></span></div>
        <div class="audit-row"><span class="audit-key">Email</span><span class="audit-val" id="a-email"></span></div>
        <div class="audit-row"><span class="audit-key">Timestamp</span><span class="audit-val" id="a-ts"></span></div>
        <div class="audit-row"><span class="audit-key">IP Address</span><span class="audit-val" id="a-ip">192.168.x.x (simulated)</span></div>
        <div class="audit-row"><span class="audit-key">Document Hash</span><span class="audit-val" id="a-hash"></span></div>
        <div class="audit-row"><span class="audit-key">Status</span><span class="audit-val audit-green">Legally binding · ESIGN/UETA compliant</span></div>
      </div>
      <button class="btn-restart" onclick="restart()">Try Another Document</button>
    </div>
  </div>
</div>
</section>

<style>
.tool-section{background:var(--bg-alt,#111);padding:64px 0;border-top:1px solid var(--border,#222);border-bottom:1px solid var(--border,#222)}
.tool-wrap{max-width:760px;margin:0 auto;padding:0 24px}
