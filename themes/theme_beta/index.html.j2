        <div class="hsteps">{% for b in section.bullets %}<div class="hstep"><div class="hstep-num">{{ '%02d' % loop.index }}</div><div class="hstep-label">{{ b.label }}</div><div class="hstep-text">{{ b.text }}</div></div>{% endfor %}</div>
      </div>
