        <div class="accordion">{% for b in section.bullets %}<div class="accordion-item"><button class="accordion-btn" data-idx="{{ loop.index0 }}">{{ b.label }}</button><div class="accordion-body" id="acc-{{ loop.index0 }}"><div class="accordion-body-inner">{{ b.text }}</div></div></div>{% endfor %}</div>
      </div>
    </section>

    {% endif %}
  {% endfor %}
  </main>

  <!-- ── Footer ── -->
  <footer class="footer">
    <div class="footer-brand">{{ config.site.name }}</div>
    {% if content.footer is defined %}<p>{{ content.footer.tagline | default('') }}</p>{% endif %}
    <p class="footer-year">© {{ now_year }} {{ config.site.name }}. All rights reserved.</p>
  </footer>

  {{ schema_ld | safe }}

  <script>
    document.querySelectorAll('.accordion-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx  = btn.dataset.idx;
        const body = document.getElementById('acc-' + idx);
        const open = btn.classList.contains('open');
        document.querySelectorAll('.accordion-btn').forEach(b => b.classList.remove('open'));
        document.querySelectorAll('.accordion-body').forEach(b => b.classList.remove('open'));
        if (!open) { btn.classList.add('open'); body.classList.add('open'); }
      });
    });
  </script>
</body>
</html>
