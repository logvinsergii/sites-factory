.doc-title-row{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.doc-badge{background:var(--accent,#f0a500);color:#000;font-size:.65rem;font-weight:800;padding:3px 8px;border-radius:4px;letter-spacing:.08em}
.doc-title-text{font-weight:700;font-size:1rem;color:var(--text,#fff)}
.doc-meta{font-size:.75rem;color:var(--text-soft,#888)}
.doc-body{padding:24px;font-size:.85rem;color:#aaa;line-height:1.7;border-bottom:1px solid #2a2a2a}
.doc-fields{padding:24px;display:flex;flex-direction:column;gap:16px}
.field-row{display:flex;flex-direction:column;gap:6px}
