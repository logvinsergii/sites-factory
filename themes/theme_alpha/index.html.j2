        <h2 class="section-heading">{{ section.heading }}</h2>
        {% if section.paragraphs %}<p class="section-intro">{{ section.paragraphs[0] }}</p>{% endif %}
        <div style="overflow-x:auto">
        <table class="state-table">
          {% for b in section.bullets %}
            {% set cols = b.text.split(' | ') %}
            {% if loop.first %}
            <thead><tr>
              <th>{{ b.label }}</th>
              {% for col in cols %}<th>{{ col }}</th>{% endfor %}
            </tr></thead><tbody>
            {% else %}
            <tr>
              <td class="state-name">{{ b.label }}</td>
              {% for col in cols %}<td>{{ col }}</td>{% endfor %}
            </tr>
            {% endif %}
          {% endfor %}
          </tbody>
        </table>
        </div>
      </div>
    </section>

    {# ── industry_notes_cards ── #}
    {% elif section.id == 'industry_notes_cards' %}
    <section class="section">
      <div class="page-wrap">
        <h2 class="section-heading">{{ section.heading }}</h2>
        {% if section.paragraphs %}<p class="section-intro">{{ section.paragraphs[0] }}</p>{% endif %}
        <div class="industry-grid">
          {% for b in section.bullets %}
          <div class="industry-card">
            <div class="industry-label">{{ b.label }}</div>
            <div class="industry-text">{{ b.text }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    {# ── retention_timeline ── #}
    {% elif section.id == 'retention_timeline' %}
    <section class="section section--alt">
      <div class="page-wrap">
        <h2 class="section-heading">{{ section.heading }}</h2>
        {% if section.paragraphs %}<p class="section-intro">{{ section.paragraphs[0] }}</p>{% endif %}
        <div class="retention-list">
          {% for b in section.bullets %}
          <div class="retention-item">
            <div class="retention-dot"></div>
            <div>
              <div class="retention-label">{{ b.label }}</div>
              <div class="retention-text">{{ b.text }}</div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    {# ── troubleshooting_accordion (always last) ── #}
    {% elif section.id == 'troubleshooting_accordion' %}
    <section class="section">
      <div class="page-wrap">
        <h2 class="section-heading">{{ section.heading }}</h2>
        {% if section.paragraphs %}<p class="section-intro">{{ section.paragraphs[0] }}</p>{% endif %}
        <div class="accordion" id="faq-accordion">
          {% for b in section.bullets %}
          <div class="accordion-item">
            <button class="accordion-btn" data-idx="{{ loop.index0 }}">{{ b.label }}</button>
            <div class="accordion-body" id="acc-{{ loop.index0 }}">
              <div class="accordion-body-inner">{{ b.text }}</div>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </section>

    {% endif %}
  {% endfor %}
  </main>

  <!-- ── Footer ── -->
  <footer class="footer">
    <div class="footer-brand">{{ config.site.name }}</div>
    {% if content.footer is defined %}
    <p>{{ content.footer.tagline | default('') }}</p>
    {% endif %}
    <p style="margin-top:12px">© {{ now_year }} {{ config.site.name }}. All rights reserved.</p>
  </footer>

  <!-- ── Schema JSON-LD ── -->
  {{ schema_ld | safe }}

  <!-- ── Accordion JS ── -->
  <script>
    document.querySelectorAll('.accordion-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx  = btn.dataset.idx;
        const body = document.getElementById('acc-' + idx);
        const open = btn.classList.contains('open');
        // close all
        document.querySelectorAll('.accordion-btn').forEach(b => b.classList.remove('open'));
        document.querySelectorAll('.accordion-body').forEach(b => b.classList.remove('open'));
        // open clicked (if wasn't open)
        if (!open) { btn.classList.add('open'); body.classList.add('open'); }
      });
    });
  </script>

</body>
</html>
