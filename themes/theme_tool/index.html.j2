  {% elif section.id == 'fillable_fields_guide' %}
  <section class="section">
    <div class="wrap"><h2>{{ section.heading }}</h2>
    {% if section.paragraphs %}<p class="sec-sub">{{ section.paragraphs[0] }}</p>{% endif %}
    <div class="fields-list">{% for b in section.bullets %}<div class="field-item"><div class="field-label">{{ b.label }}</div><div class="field-text">{{ b.text }}</div></div>{% endfor %}</div></div>
  </section>

  {% elif section.id == 'cost_calculator_box' %}
  <section class="section section--alt">
    <div class="wrap"><h2>{{ section.heading }}</h2>
    <div class="cost-box">
      {% if section.paragraphs[0] is defined %}<p class="sec-sub">{{ section.paragraphs[0]|replace('[INTRO]','')|trim }}</p>{% endif %}
      <div class="cost-grid">{% for b in section.bullets %}<div class="cost-item"><div class="cost-item-label">{{ b.label }}</div><div class="cost-item-value">{{ b.text }}</div></div>{% endfor %}</div>
      {% if section.paragraphs[1] is defined %}<p style="font-size:.875rem;color:var(--text-2);margin-top:8px">{{ section.paragraphs[1]|replace('[OUTRO]','')|trim }}</p>{% endif %}
    </div></div>
  </section>

  {% elif section.id == 'roi_stats_banner' %}
  <section class="section">
    <div class="wrap"><div class="roi-banner">
      <h2>{{ section.heading }}</h2>
      {% if section.paragraphs %}<p class="sec-sub">{{ section.paragraphs[0] }}</p>{% endif %}
      <div class="roi-stats">{% for b in section.bullets %}<div><div class="roi-stat-label">{{ b.label }}</div><div class="roi-stat-text">{{ b.text }}</div></div>{% endfor %}</div>
    </div></div>
  </section>

  {% elif section.id == 'state_requirements_table' %}
  <section class="section section--alt">
    <div class="wrap"><h2>{{ section.heading }}</h2>
    {% if section.paragraphs %}<p class="sec-sub">{{ section.paragraphs[0] }}</p>{% endif %}
    <div class="tbl-wrap"><table class="tbl">
      {% for b in section.bullets %}{% set cols = b.text.split(' | ') %}{% if loop.first %}<thead><tr><th>{{ b.label }}</th>{% for c in cols %}<th>{{ c }}</th>{% endfor %}</tr></thead><tbody>{% else %}<tr><td class="tbl-label">{{ b.label }}</td>{% for c in cols %}<td>{{ c }}</td>{% endfor %}</tr>{% endif %}{% endfor %}</tbody>
    </table></div></div>
  </section>

  {% elif section.id == 'industry_notes_cards' %}
  <section class="section">
    <div class="wrap"><h2>{{ section.heading }}</h2>
    {% if section.paragraphs %}<p class="sec-sub">{{ section.paragraphs[0] }}</p>{% endif %}
    <div class="industry-grid">{% for b in section.bullets %}<div class="industry-card"><div class="industry-label">{{ b.label }}</div><div class="industry-text">{{ b.text }}</div></div>{% endfor %}</div></div>
  </section>

  {% elif section.id == 'retention_timeline' %}
  <section class="section section--alt">
    <div class="wrap"><h2>{{ section.heading }}</h2>
    {% if section.paragraphs %}<p class="sec-sub">{{ section.paragraphs[0] }}</p>{% endif %}
    <div class="retention-list">{% for b in section.bullets %}<div class="retention-item"><div class="retention-dot"></div><div><div class="retention-label">{{ b.label }}</div><div class="retention-text">{{ b.text }}</div></div></div>{% endfor %}</div></div>
  </section>

  {% elif section.id == 'troubleshooting_accordion' %}
  <section class="section">
    <div class="wrap" style="max-width:720px"><h2>{{ section.heading }}</h2>
    {% if section.paragraphs %}<p class="sec-sub">{{ section.paragraphs[0] }}</p>{% endif %}
    <div class="faq">{% for b in section.bullets %}<div class="fqi"><button class="fqb" data-i="{{ loop.index0 }}">{{ b.label }}<div class="fqi-icon">+</div></button><div class="fqbody" id="fq{{ loop.index0 }}"><p>{{ b.text }}</p></div></div>{% endfor %}</div></div>
  </section>
  {% endif %}

{% endfor %}
</main>

<!-- Footer -->
<footer class="footer">
  <div class="footer-in">
    <div class="footer-brand">✦ {{ config.site.name }}</div>
    <div class="footer-note">
      {% if content.footer is defined %}{{ content.footer.tagline | default('') }} · {% endif %}
      © {{ now_year }} {{ config.site.name }}
    </div>
  </div>
</footer>

{{ schema_ld | safe }}

<script>
// ── Canvas ────────────────────────────────────────────────────────────────
const canvas=document.getElementById('sig-canvas'),ctx=canvas.getContext('2d'),ca=document.getElementById('ca'),cph=document.getElementById('cph');
let drawing=false,hasDrawn=false,inkColor='#111827',inkWidth=2.8;
function initC(){const dpr=window.devicePixelRatio||1,w=ca.clientWidth,h=220;canvas.width=w*dpr;canvas.height=h*dpr;canvas.style.height=h+'px';ctx.scale(dpr,dpr);ctx.lineCap='round';ctx.lineJoin='round';}
initC();
function gxy(e){const r=canvas.getBoundingClientRect();if(e.touches)return{x:e.touches[0].clientX-r.left,y:e.touches[0].clientY-r.top};return{x:e.clientX-r.left,y:e.clientY-r.top};}
canvas.addEventListener('mousedown',e=>{drawing=true;const p=gxy(e);ctx.beginPath();ctx.moveTo(p.x,p.y);if(!hasDrawn){cph.style.opacity='0';hasDrawn=true;}});
canvas.addEventListener('mousemove',e=>{if(!drawing)return;const p=gxy(e);ctx.strokeStyle=inkColor;ctx.lineWidth=inkWidth;ctx.lineTo(p.x,p.y);ctx.stroke();ctx.beginPath();ctx.moveTo(p.x,p.y);});
canvas.addEventListener('mouseup',()=>drawing=false);canvas.addEventListener('mouseleave',()=>drawing=false);
canvas.addEventListener('touchstart',e=>{e.preventDefault();drawing=true;const p=gxy(e);ctx.beginPath();ctx.moveTo(p.x,p.y);if(!hasDrawn){cph.style.opacity='0';hasDrawn=true;}},{passive:false});
canvas.addEventListener('touchmove',e=>{e.preventDefault();if(!drawing)return;const p=gxy(e);ctx.strokeStyle=inkColor;ctx.lineWidth=inkWidth;ctx.lineTo(p.x,p.y);ctx.stroke();ctx.beginPath();ctx.moveTo(p.x,p.y);},{passive:false});
canvas.addEventListener('touchend',()=>drawing=false);
document.getElementById('btn-clear').addEventListener('click',()=>{ctx.clearRect(0,0,canvas.width,canvas.height);hasDrawn=false;cph.style.opacity='1';});
document.querySelectorAll('.cbtn').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.cbtn').forEach(x=>x.classList.remove('active'));b.classList.add('active');inkColor=b.dataset.color;}));
document.querySelectorAll('.wbtn').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.wbtn').forEach(x=>x.classList.remove('active'));b.classList.add('active');inkWidth=parseFloat(b.dataset.w);}));
// ── Tabs ─────────────────────────────────────────────────────────────────
let activeTab='draw';
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>{activeTab=t.dataset.tab;document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));t.classList.add('active');document.getElementById('panel-'+activeTab).classList.add('active');}));
// ── Type mode ─────────────────────────────────────────────────────────────
let activeFont="'Dancing Script',cursive";
const tdisplay=document.getElementById('tdisplay'),tph=document.getElementById('tph'),tinput=document.getElementById('type-input');
tinput.addEventListener('input',()=>{const v=tinput.value.trim();if(v){tph.style.display='none';tdisplay.style.display='block';tdisplay.textContent=v;}else{tph.style.display='block';tdisplay.style.display='none';}});
document.querySelectorAll('.fc').forEach(c=>c.addEventListener('click',()=>{document.querySelectorAll('.fc').forEach(x=>x.classList.remove('active'));c.classList.add('active');activeFont=c.dataset.font;tdisplay.style.fontFamily=activeFont;}));
// ── Download ──────────────────────────────────────────────────────────────
document.getElementById('btn-dl').addEventListener('click',()=>{
  if(activeTab==='draw'){const l=document.createElement('a');l.download='my-signature.png';l.href=canvas.toDataURL('image/png');l.click();}
  else{const text=tinput.value.trim();if(!text){alert('Please type your name first.');return;}const dpr=window.devicePixelRatio||1,W=700,H=220,off=document.createElement('canvas');off.width=W*dpr;off.height=H*dpr;const oc=off.getContext('2d');oc.scale(dpr,dpr);const fs=Math.min(120,Math.floor(W*0.85/Math.max(text.length,2)));oc.font=fs+'px '+activeFont;oc.fillStyle=inkColor;oc.textAlign='center';oc.textBaseline='middle';oc.fillText(text,W/2,H/2);const l=document.createElement('a');l.download='my-signature.png';l.href=off.toDataURL('image/png');l.click();}
});
// ── FAQ ───────────────────────────────────────────────────────────────────
document.querySelectorAll('.fqb').forEach(b=>b.addEventListener('click',()=>{const i=b.dataset.i,body=document.getElementById('fq'+i),open=b.classList.contains('open');document.querySelectorAll('.fqb').forEach(x=>x.classList.remove('open'));document.querySelectorAll('.fqbody').forEach(x=>x.classList.remove('open'));if(!open){b.classList.add('open');body.classList.add('open');}}));
</script>
</body>
</html>
