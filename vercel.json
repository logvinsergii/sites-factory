{
  "version": 2,
  "buildCommand": "python -m venv /tmp/venv && /tmp/venv/bin/pip install -r requirements.txt && /tmp/venv/bin/python build.py --site sites/esign_002",
  "outputDirectory": "sites/esign_002/output",
  "installCommand": "python -m venv /tmp/venv && /tmp/venv/bin/pip install -r requirements.txt",
  "framework": null,
  "routes": [
    { "src": "/sitemap.xml", "dest": "/sitemap.xml", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/robots.txt",  "dest": "/robots.txt",  "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
