{
  "version": 2,
  "buildCommand": "PIP_CONFIG_FILE=pip_config/pip.conf pip install -r requirements.txt && python build.py --site sites/esign_002",
  "outputDirectory": "sites/esign_002/output",
  "installCommand": "PIP_CONFIG_FILE=pip_config/pip.conf pip install -r requirements.txt",
  "framework": null,
  "routes": [
    { "src": "/sitemap.xml", "dest": "/sitemap.xml", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/robots.txt", "dest": "/robots.txt", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
